        <mxCell id="governance" value="&lt;b&gt;Governance (layer 2)&lt;/b&gt;&lt;br&gt;Scope: rg-az104-connected&lt;br&gt;&lt;br&gt;Policy: cost_center tag, &lt;b&gt;Deny&lt;/b&gt;&lt;br&gt;Policy: project tag, &lt;b&gt;Audit&lt;/b&gt;&lt;br&gt;Policy: East US 2 only, &lt;b&gt;Deny&lt;/b&gt;&lt;br&gt;&lt;br&gt;Budget: $25/month, email at 50% and 90%&lt;br&gt;&lt;br&gt;Tags on everything: owner, cost_center, environment, project" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFF8E6;strokeColor=#C19C00;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
